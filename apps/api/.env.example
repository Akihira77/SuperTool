# Port server API + UI
ST_PORT=3001
ST_HOST=127.0.0.1
# Folder data (auth.json, notes.json)
# Data pengguna di luar folder project (default ~/.local/share/super-tool)
ST_DATA_DIR=
# Root yang boleh diakses file explorer, dipisah titik dua (:). Default: home user
ST_FS_ROOTS=/home/akihira17
# Folder konfigurasi nginx
ST_NGINX_DIR=/etc/nginx
# Folder log yang boleh dibaca Log Tailer di luar ST_FS_ROOTS (dipisah koma)
ST_LOG_ROOTS=/var/log
# Izinkan proxy ke host publik (default hanya localhost/jaringan privat)
ST_PROXY_ALLOW_PUBLIC=0
# LLM kompatibel OpenAI untuk fitur "jelaskan ke LLM" (9router/ollama/dll)
ST_LLM_BASE_URL=http://127.0.0.1:20128/v1
ST_LLM_MODEL=
ST_LLM_API_KEY=
